	<xs:simpleType name="stSTRING_9_ZP">
		<xs:restriction base="stSTRING">
			<xs:pattern value="[0-9/. \-]+"/>
			<xs:minLength value="1" />
			<xs:maxLength value="9" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stBOOLEAN">
    	<xs:restriction base="xs:boolean"/>
    </xs:simpleType>
	<xs:simpleType name="stSTRING_ZAHL_1">
		<xs:restriction base="stSTRING">
			<xs:pattern value="[0-9]+|[0-9]+.[0-9]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stSTRING_ZAHL_2">
		<xs:restriction base="stSTRING">
			<xs:pattern value="[0-9]+|[0-9]+.[0-9]|[0-9]+.[0-9]{2}"/>
