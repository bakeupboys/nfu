<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://pim.datanature.info" xmlns="http://pim.datanature.info"
	elementFormDefault="qualified">

	<xs:element name="datanature">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="header" />
				<xs:element ref="brands" />
				<xs:element ref="producers" />
				<xs:element ref="products" />
				<xs:element ref="wiki" />
			</xs:sequence>
			<xs:attribute name="version" type="stSTRING" use="required" />
		</xs:complexType>
	</xs:element>

	<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SIMPLE TYPES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	<xs:simpleType name="stINTEGER">
		<xs:restriction base="xs:integer" />
	</xs:simpleType>
	<xs:simpleType name="stTIME">
		<xs:restriction base="xs:string">
			<xs:pattern value="(0[0-9]|1[0-9]|2[0-3])(:[0-5][0-9])(:[0-5][0-9](\.[0-9]{1,}){0,1}){0,1}"/>
		</xs:restriction>
	</xs:simpleType>
		<xs:simpleType name="stDECIMAL">
		<xs:restriction base="xs:decimal" />
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_1">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_2">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_3">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_3_POSTITVE">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="3"/>
			<xs:minExclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_4">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_5">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="5"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDECIMAL_16">
		<xs:restriction base="xs:decimal" >
			<xs:fractionDigits value="16"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDATE">
		<xs:restriction base="xs:string">
			<xs:pattern value="(0[1-9]|[12][0-9]|3[01])\.(0[1-9]|1[012])\.\d\d\d\d"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stDATETIME">
		<xs:restriction base="xs:string">
			<xs:pattern value="(0[1-9]|[12][0-9]|3[01])\.(0[1-9]|1[012])\.\d\d\d\d (0[0-9]|1[0-9]|2[0-3])(:[0-5][0-9])(:[0-5][0-9](\.[0-9]{1,}){0,1}){0,1}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stTIMEZONE">
		<xs:restriction base="xs:string">
			<xs:pattern value="([+\-]([0-1][0-9]|2[0-3])(:[0-5][0-9]))|Z" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stGUID">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stREG_NR">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-zA-Z]{2}[0-9]{13}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stSTRING_24_STRICT">
		<xs:restriction base="stSTRING">
			<xs:minLength value="24" />
			<xs:maxLength value="24" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stSTRING_6_UN">
		<xs:restriction base="xs:string">
			<xs:pattern value="UN[0-9]{4}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stSTRING">
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="stSTRING_3">
